# Django Settings
# Generate a private key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave empty for SQLite in development)
DATABASE_URL=

# Email Configuration (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
# Reservation alerts go to the shop, independently of WhatsApp sending.
RESERVATION_NOTIFICATION_EMAIL=
# Set a real sending backend and its credentials to deliver emails:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False

# Checkout opens WhatsApp for the customer to send their saved order.
# Use your business number with international country code.
WHATSAPP_SHOP_NUMBER=

# Public Microsoft Clarity project ID (only loaded when DEBUG=False).
# Set empty to disable tracking.
CLARITY_PROJECT_ID=zjljk7do8k

# Production settings (uncomment for production)
# DEBUG=False
# APP_ENV=production
# ALLOWED_HOSTS=your-project.vercel.app
# DATABASE_URL=postgres://user:password@host:port/dbname

# Vercel + Neon (set these in Vercel, not in a committed file):
# SECRET_KEY=<random value of at least 50 characters>
# DEBUG=False
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# ALLOWED_HOSTS=your-project.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app
# Vercel also supplies VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL automatically.
