{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Django: runserver",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-u", "manage.py", "runserver", "127.0.0.1:8000"],
      "options": { "cwd": "${workspaceFolder}", "env": { "DEBUG": "True", "ENABLE_LIVERELOAD": "True" } },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "django-development" }
    },
    {
      "label": "Django: LiveReload",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-u", "manage.py", "livereload", "--host=127.0.0.1", "--port=35729"],
      "options": { "cwd": "${workspaceFolder}", "env": { "DEBUG": "True", "ENABLE_LIVERELOAD": "True" } },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "django-development" }
    },
    {
      "label": "Dev: Django + LiveReload",
      "dependsOn": ["Django: runserver", "Django: LiveReload"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
